# saas-core — serviço central de planos/assinaturas do SaaS.
# Copie este arquivo para .env e substitua os valores de exemplo.
# Nunca versione .env nem insira segredos reais no repositório.

# Token que protege os endpoints de operador (criar/listar restaurante,
# atribuir plano) — gere algo aleatório com pelo menos 32 caracteres, ex.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPERATOR_TOKEN=

# Painel Master (Super Admin) — login real, separado do OPERATOR_TOKEN acima
# (que é só pra scripts/CLI) e da API key de cada restaurante.
# Gere com o mesmo comando do OPERATOR_TOKEN acima:
PLATFORM_JWT_SECRET=
# Opcional — nome do cookie de sessão do Painel Master (default: platform_session)
PLATFORM_SESSION_COOKIE_NAME=

# Preenchidas só no primeiro boot: criam a primeira conta de Super Admin
# (idempotente — se a conta já existir, não faz nada). Depois de criada,
# pode deixar em branco ou trocar a senha pela própria interface no futuro.
BOOTSTRAP_SUPERADMIN_NAME=
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Defina como "true" somente em produção, atrás de um reverse proxy confiável.
TRUST_PROXY=false

# Modo Suporte — quanto tempo (ms) o link de handoff pro deployment do
# restaurante fica válido, contando da emissão (cobre resgate + duração da
# sessão). Opcional — default 900000 (15 min).
SUPPORT_SESSION_TTL_MS=900000

# Cobrança da mensalidade do SaaS (restaurante-cliente pagando a plataforma) —
# conta do Mercado Pago DA PLATAFORMA, nunca a de nenhum restaurante-cliente.
# Em branco = cobrança automática desligada.
MERCADO_PAGO_ACCESS_TOKEN=
# Chave secreta de webhook (Central de vendedores → Webhooks → Configurar
# notificação, na conta do Mercado Pago DA PLATAFORMA) — opcional mas recomendada.
MERCADO_PAGO_WEBHOOK_SECRET=

# E-mails transacionais (server/_core/emailService.ts, via Resend). Em
# branco = envio desligado (loga e segue, nunca derruba o fluxo que disparou).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=MM System Creator
# Fora de produção, nunca manda e-mail de verdade pro destinatário real — se
# preenchido, redireciona todo envio pra cá; se vazio, só loga.
EMAIL_DEV_RECIPIENT=

# Origem do site comercial/Painel Master — usada só pra montar o link de ação
# (actionUrl) dos e-mails disparados fora de uma requisição (ex.: webhook).
# Sem barra no final. Trocar pelo domínio real (https://...) em produção.
COMMERCIAL_SITE_URL=http://localhost:4000

# Usadas pelo docker-compose.saas-core.yml pra subir o container do banco
MYSQL_DATABASE=saas_core
MYSQL_USER=saas_core
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Backup (scripts/backup-db.mjs e restore-db.mjs) — guarda cadastro de
# restaurantes-clientes, planos, assinaturas e auditoria da plataforma.
# Chave própria deste serviço — não precisa (nem deve) ser a mesma
# BACKUP_ENCRYPTION_KEY usada no app principal de cada restaurante-cliente.
# Em branco = backup salvo sem criptografia.
BACKUP_ENCRYPTION_KEY=
# Cópia externa (opcional, mas recomendada) — qualquer destino compatível com
# S3 (Backblaze B2, outra conta AWS, etc.). Em branco = backup fica só nesta VPS.
BACKUP_OFFSITE_S3_BUCKET=
BACKUP_OFFSITE_S3_ACCESS_KEY_ID=
BACKUP_OFFSITE_S3_SECRET_ACCESS_KEY=
BACKUP_OFFSITE_S3_ENDPOINT=
BACKUP_OFFSITE_S3_REGION=

# Assistente de manutenção só-leitura na tela Manutenção do Painel Master
# (responde perguntas sobre restaurantes/planos/auditoria com base no que o
# próprio saas-core já tem — nunca executa nada). Em branco = recurso
# desligado. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Notificações operacionais pro dono da plataforma (novo cliente pago,
# restaurante entregue) via Telegram — server/_core/telegramService.ts. Em
# branco = desligado, só loga e segue. Mesmo bot/chat já usado no app principal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Provisionamento de um ambiente novo por restaurante-cliente fica MANUAL
# de propósito (decisão do dono, 2026-09-29) — sem variável de ambiente
# nenhuma aqui. Quando um pagamento confirma, o Telegram recebe o comando
# pronto pra equipe rodar na VPS (ver server/_core/systemProvisioning.ts).

# Taxa de implementação cobrada no cadastro (Checkout Pro), em centavos, a
# mesma pra qualquer plano — configurável só pra permitir um teste real de
# ponta a ponta (Pix/cartão) com valor baixo sem mexer em código. Em branco =
# R$150,00 (padrão real). NUNCA deixar configurada baixa em produção fora de
# uma janela de teste deliberada.
IMPLEMENTATION_FEE_CENTS=

# Restaurante(s) de uso interno/demonstração do dono da plataforma — nunca
# perdem acesso por fim de trial (o período é renovado automaticamente em vez
# de bloquear). Lista de restaurantId separada por vírgula, ex.: "1,7". Em
# branco = nenhum restaurante tem esse tratamento especial.
INTERNAL_DEMO_RESTAURANT_IDS=
