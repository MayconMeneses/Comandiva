# Segredos e configuração local — nunca versionar
.env
.env.*
!.env.example

node_modules/
dist/
*.tsbuildinfo

*.log

.DS_Store
Thumbs.db

# Backups de banco de dados — nunca versionar dump nenhum
backups/
*.sql
*.sql.gz
*.tar.gz
*.tar.gz.enc
# Exceção: migrations do Drizzle (drizzle/*.sql) precisam ser versionadas —
# sem isto, toda migration nova ficava invisível pro git por engano (só as
# 0000-0008 estão versionadas hoje porque entraram via `git add -f` na época).
!drizzle/*.sql
