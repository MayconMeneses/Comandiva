# MM System Creator — configuração local/produção
# Copie este arquivo para .env e substitua os valores de exemplo.
# Nunca versione .env nem insira segredos reais no repositório.

NODE_ENV=development
PORT=3000
APP_ID=pubx
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# MySQL/MariaDB via Drizzle ORM + mysql2
DATABASE_URL=mysql://pubx:troque-esta-senha@localhost:3306/pubx
# Quantas conexões simultâneas o app pode abrir com o banco. Aumente se o site
# tiver muito acesso ao mesmo tempo (o MySQL do container aceita até 151 por
# padrão). 20 é um bom ponto de partida para uma VPS pequena/média.
DB_POOL_SIZE=20

# Sessão local assinada
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
SESSION_COOKIE_NAME=pubx_session
COOKIE_SECURE=false
PRIMARY_ADMIN_OPEN_ID=admin-principal
BOOTSTRAP_ADMIN_NAME=Administrador principal
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=troque-por-uma-senha-forte

# S3-compatible/MinIO — storage independente
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pubx-assets
S3_ACCESS_KEY_ID=troque-este-id
S3_SECRET_ACCESS_KEY=troque-este-segredo
S3_PUBLIC_BASE_URL=http://localhost:9000/pubx-assets

# E-mail opcional; não há envio implementado na versão atual
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MM System Creator <noreply@example.com>

# Para quem enviar avisos quando o servidor tiver um erro grave (ex.: sua conta de e-mail pessoal)
ALERT_EMAIL_TO=
# Opcional: URL de webhook (ex.: Zapier/Make/CallMeBot) para também receber o alerta por WhatsApp/Telegram
ALERT_WEBHOOK_URL=

# Backup (scripts/backup-db.mjs e restore-db.mjs) — banco + storage juntos
# num único .tar.gz. Em branco = comportamento mínimo (só o banco, sem
# criptografia, sem cópia externa) — cada parte liga sozinha ao ser preenchida.
# Chave de criptografia do arquivo final (AES-256-GCM). Gere com o mesmo
# comando sugerido pra JWT_SECRET acima.
BACKUP_ENCRYPTION_KEY=
# Destino externo (qualquer serviço compatível com S3, ex.: Backblaze B2) pra
# onde a cópia do backup é enviada — sem isso, o backup fica só nesta VPS.
BACKUP_OFFSITE_S3_ENDPOINT=
BACKUP_OFFSITE_S3_REGION=us-east-1
BACKUP_OFFSITE_S3_BUCKET=
BACKUP_OFFSITE_S3_ACCESS_KEY_ID=
BACKUP_OFFSITE_S3_SECRET_ACCESS_KEY=

# Fiscal (Admin > Fiscal, emissão de NFC-e direto com a SEFAZ-CE) — cifra o
# certificado digital A1 e o token CSC salvos ali (AES-256-GCM). Gere com o
# mesmo comando sugerido pra JWT_SECRET acima. Em branco = a tela recusa
# salvar certificado/token (dados cadastrais como CNPJ continuam editáveis).
FISCAL_ENCRYPTION_KEY=

# Defina como "true" somente se o site rodar atrás de um proxy reverso confiável
# (ex.: Nginx/Caddy na frente do Docker). Isso é usado para identificar o IP
# real do visitante corretamente (importante para o limitador de tentativas de login).
TRUST_PROXY=false

# Integrações opcionais
MAPS_PROVIDER=none
MAPS_API_KEY=
# SMS_PROVIDER=none (padrão): o código de verificação do autoatendimento LGPD
# (/meus-dados, server/routers/dataRights.ts) só é registrado no log do
# servidor, sem enviar de verdade — o fluxo continua testável, só sem SMS
# real. Defina SMS_PROVIDER=twilio + as três variáveis TWILIO_* abaixo (conta
# em twilio.com) para enviar SMS de verdade.
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_PROVIDER=none
WHATSAPP_API_KEY=
ANALYTICS_ENDPOINT=
ANALYTICS_WEBSITE_ID=

# Camada SaaS (saas-core) — em branco = licenciamento desligado, sem mudar
# nenhum comportamento existente. Preencha só se este deployment for cliente
# de um saas-core (ver scripts/create-restaurant.ts no saas-core).
SAAS_CORE_URL=
SAAS_CORE_API_KEY=
LICENSE_SYNC_INTERVAL_MS=300000

# Modo Suporte — em branco = recurso desligado. Segredo próprio, nunca o
# JWT_SECRET de sessão real (ver server/_core/supportSession.ts).
SUPPORT_SESSION_SECRET=

# Frontend
VITE_APP_TITLE=MM System Creator — Sistema de Pedidos
VITE_API_URL=/api/trpc
VITE_APP_LOGO=/pubx-logo.svg
