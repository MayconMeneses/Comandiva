# Pub X — configuração local/produção
# Copie este arquivo para .env e substitua os valores de exemplo.
# Nunca versione .env nem insira segredos reais no repositório.

NODE_ENV=development
PORT=3000
APP_ID=pubx
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# MySQL/MariaDB via Drizzle ORM + mysql2
DATABASE_URL=mysql://pubx:troque-esta-senha@localhost:3306/pubx
# Quantas conexões simultâneas o app pode abrir com o banco. Aumente se o site
# tiver muito acesso ao mesmo tempo (o MySQL do container aceita até 151 por
# padrão). 20 é um bom ponto de partida para uma VPS pequena/média.
DB_POOL_SIZE=20

# Sessão local assinada
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
SESSION_COOKIE_NAME=pubx_session
COOKIE_SECURE=false
PRIMARY_ADMIN_OPEN_ID=admin-principal
BOOTSTRAP_ADMIN_NAME=Administrador principal
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Defina como "true" somente em produção, atrás de um reverse proxy confiável
# (Caddy/Nginx/etc). Sem isso, o rate limit de login passa a enxergar todo
# mundo com o IP do proxy e perde o efeito. Deixe "false" em desenvolvimento
# local, sem proxy na frente.
TRUST_PROXY=false

# S3-compatible/MinIO — storage independente
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pubx-assets
S3_ACCESS_KEY_ID=troque-este-id
S3_SECRET_ACCESS_KEY=troque-este-segredo
S3_PUBLIC_BASE_URL=http://localhost:9000/pubx-assets

# E-mail para alertas de erro grave (opcional) — deixe em branco pra desativar
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pub X <noreply@example.com>

# Para quem enviar avisos quando o servidor tiver um erro grave (ex.: sua conta de e-mail pessoal)
ALERT_EMAIL_TO=
# Opcional: URL de webhook genérico (ex.: Zapier/Make) que também recebe o alerta
ALERT_WEBHOOK_URL=
# Alertas em tempo real pelo Telegram (recomendado — canal principal).
# Como configurar: fale com @BotFather no Telegram, use /newbot, copie o
# token gerado em TELEGRAM_BOT_TOKEN. Pra descobrir o TELEGRAM_CHAT_ID, dê
# start no seu bot, mande uma mensagem qualquer e acesse
# https://api.telegram.org/bot<SEU_TOKEN>/getUpdates — o "chat":{"id":...}
# na resposta é o seu chat ID (pode ser o seu chat pessoal ou o de um grupo).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Camada de licenciamento (SaaS/white-label) — deixe em branco se este
# deployment não faz parte do SaaS comercializado (comportamento padrão,
# tudo liberado). Preenchido, este app passa a sincronizar periodicamente
# com o serviço saas-core pra saber o plano/features/limites do restaurante.
SAAS_CORE_URL=
SAAS_CORE_API_KEY=
LICENSE_SYNC_INTERVAL_MS=300000

# Modo Suporte — permite que o dono da plataforma (Painel Master do
# saas-core) abra uma visão somente-leitura deste restaurante pra
# diagnóstico. Deixe em branco pra desativar (nenhum efeito no login normal).
# Gere com o mesmo comando do JWT_SECRET acima.
SUPPORT_SESSION_SECRET=

# Integrações opcionais
MAPS_PROVIDER=none
MAPS_API_KEY=
SMS_PROVIDER=none
SMS_API_KEY=
WHATSAPP_PROVIDER=none
WHATSAPP_API_KEY=
ANALYTICS_ENDPOINT=
ANALYTICS_WEBSITE_ID=

# Frontend
VITE_APP_TITLE=Pub X — Sistema de Pedidos
VITE_API_URL=/api/trpc
VITE_APP_LOGO=/pubx-logo.svg
